{
  "name": "app-composer-ldraw",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4396",
    "build": "node scripts/catalogue.mjs --check && node scripts/brand-assets.mjs --check && node scripts/seo.mjs && node scripts/build.mjs",
    "check": "node scripts/brand-assets.mjs --check && node scripts/seo.mjs && tsc --noEmit && node scripts/catalogue.mjs --check && node scripts/architecture-build.mjs --check && node scripts/compositions-build.mjs --check && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests *.json *.html",
    "scene": "node scripts/scene.mjs",
    "render": "node scripts/render.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "mcp:font-metrics": "node scripts/font-metrics.mjs",
    "qualify": "node scripts/qualify.mjs",
    "deploy": "node scripts/deploy.mjs",
    "mcp:demo": "node scripts/mcp-demo.mjs",
    "assets:harvest": "node scripts/harvest-assets.mjs --write",
    "assets:check": "node scripts/harvest-assets.mjs --check",
    "assets:discover": "node scripts/harvest-assets.mjs --discover",
    "catalogue:write": "node scripts/catalogue.mjs --write",
    "architecture:build": "node scripts/architecture-build.mjs --write",
    "architecture:check": "node scripts/architecture-build.mjs --check",
    "compositions:build": "node scripts/compositions-build.mjs --write",
    "compositions:check": "node scripts/compositions-build.mjs --check",
    "brand": "node scripts/brand-assets.mjs",
    "brand:check": "node scripts/brand-assets.mjs --check",
    "seo": "node scripts/seo.mjs",
    "seo:write": "node scripts/seo.mjs --write",
    "seo:serve": "node scripts/serve-seo.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/server": "2.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.143.1"
  }
}
